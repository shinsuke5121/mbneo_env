# ~/.ssh/config
# MacBook Neo - SSH 接続設定テンプレート
# このファイルを ~/.ssh/config にコピーして、各値を実環境に合わせて編集してください

# ----------------------------------------
# 共通設定
# ----------------------------------------
Host *
  ServerAliveInterval 60
  ServerAliveCountMax 3
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_ed25519

# ----------------------------------------
# Pi5 NAS
# ----------------------------------------
Host pi5
  HostName 192.168.x.x          # Pi5 の IP アドレス (固定IP推奨)
  User pi                       # ユーザー名
  Port 22
  # Tailscale 経由の場合は HostName を Tailscale IP (100.x.x.x) に変更

# Pi5 への SSHFS マウント用エイリアスは ~/.zshrc に定義
# alias mount-nas='sshfs pi5:/mnt/data ~/Mounts/nas -o reconnect,follow_symlinks'
# alias umount-nas='umount ~/Mounts/nas'

# ----------------------------------------
# BTO Windows (SSH サーバが有効な場合)
# ----------------------------------------
Host bto-win
  HostName 192.168.x.x          # Windows PC の IP アドレス
  User YourWindowsUsername
  Port 22
  # Windows の OpenSSH サーバ有効化:
  # 設定 > システム > オプション機能 > OpenSSH サーバ を追加

# Windows への RDP は Microsoft Remote Desktop アプリを使用
# (SSH 経由のポートフォワード例)
# alias rdp-via-ssh='ssh -L 3389:localhost:3389 bto-win -N &'

# ----------------------------------------
# Tailscale 経由 (外出先からアクセス)
# ----------------------------------------
# Tailscale をインストールすれば上記の HostName を
# Tailscale IP (100.x.x.x) に変えるだけで外部からも接続可能
